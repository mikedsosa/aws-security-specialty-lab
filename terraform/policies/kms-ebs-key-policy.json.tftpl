{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KeyAdministrationWithoutUse",
      "Effect": "Allow",
      "Principal": {
        "AWS": ${jsonencode(key_admin_arns)}
      },
      "Action": [
        "kms:CancelKeyDeletion",
        "kms:Create*",
        "kms:Delete*",
        "kms:Describe*",
        "kms:Disable*",
        "kms:Enable*",
        "kms:Get*",
        "kms:List*",
        "kms:Put*",
        "kms:Revoke*",
        "kms:ScheduleKeyDeletion",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:Update*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowEbsViaEc2",
      "Effect": "Allow",
      "Principal": {
        "AWS": ${jsonencode(ebs_user_arns)}
      },
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ec2.${region}.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowEbsCreateGrant",
      "Effect": "Allow",
      "Principal": {
        "AWS": ${jsonencode(ebs_user_arns)}
      },
      "Action": "kms:CreateGrant",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ec2.${region}.amazonaws.com"
        },
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    }
  ]
}
