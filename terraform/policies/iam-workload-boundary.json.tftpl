{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowWorkloadData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${name_prefix}-app-*",
        "arn:aws:s3:::${name_prefix}-app-*/*"
      ]
    },
    {
      "Sid": "AllowWorkloadTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:${region}:${account_id}:table/${name_prefix}-app-*"
    },
    {
      "Sid": "AllowOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:${region}:${account_id}:log-group:/aws/lambda/${name_prefix}-app-*:*"
    },
    {
      "Sid": "DenyIdentityAndOrgChanges",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "organizations:*",
        "sts:AssumeRole"
      ],
      "Resource": "*"
    }
  ]
}
