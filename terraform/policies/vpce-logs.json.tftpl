{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOrgPrincipalsToLogs",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "${organization_id}"
        }
      }
    }
  ]
}
