{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReplicaBucketAccessLogs",
      "Effect": "Allow",
      "Principal": {
        "Service": "logging.s3.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${bucket_name}/org-trail-replica/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "${management_account_id}"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:s3:::${source_bucket_name}"
        }
      }
    },
    {
      "Sid": "LogReaderReadOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "${log_reader_arn}"
      },
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${bucket_name}",
        "arn:aws:s3:::${bucket_name}/*"
      ]
    },
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::${bucket_name}",
        "arn:aws:s3:::${bucket_name}/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyLogDeletion",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::${bucket_name}/*"
    }
  ]
}
